{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "github>repobuddy/renovate-preset",
    ":semanticCommitTypeAll(chore)"
  ],
  "minimumReleaseAge": "1 day",
  "internalChecksFilter": "strict",
  "platformAutomerge": true,
  "lockFileMaintenance": {
    "enabled": true,
    "automerge": true
  },
  "packageRules": [
    {
      "description": "The toolchain pins (mise, nvm) move with packageManager, so they merge themselves too.",
      "matchManagers": ["mise"],
      "matchUpdateTypes": ["minor", "patch", "pin", "digest"],
      "automerge": true
    },
    {
      "description": "Automerge devDependencies and workspace tooling on non-major updates.",
      "matchDepTypes": ["devDependencies", "packageManager"],
      "matchUpdateTypes": ["minor", "patch", "pin", "digest"],
      "automerge": true
    },
    {
      "description": "Automerge GitHub Actions on non-major updates.",
      "matchManagers": ["github-actions"],
      "matchUpdateTypes": ["minor", "patch", "digest"],
      "automerge": true
    }
  ]
}
