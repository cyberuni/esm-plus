{
  "$schema": "https://turborepo.com/schema.json",
  "tasks": {
    "clean": {
      "cache": false
    },
    "coverage": {
      "inputs": [
        "package.json",
        "tsconfig.json",
        "vitest.config.mts",
        "**/*.{js,cjs,mjs,ts,cts,mts}"
      ],
      "outputs": ["coverage/**"]
    },
    "depcheck": {
      "inputs": ["package.json", ".depcheckrc.yaml", "**/*.{js,cjs,mjs,ts,cts,mts}"]
    },
    "dev": {
      "cache": false
    },
    "nuke": {
      "cache": false
    },
    "test": {
      "inputs": [
        "package.json",
        "tsconfig.json",
        "vitest.config.mts",
        "**/*.{js,cjs,mjs,ts,cts,mts}"
      ]
    },
    "typecheck": {
      "inputs": [
        "package.json",
        "tsconfig.json",
        "vitest.config.mts",
        "**/*.{js,cjs,mjs,ts,cts,mts}"
      ]
    },
    "watch": {
      "cache": false,
      "persistent": true
    }
  }
}
